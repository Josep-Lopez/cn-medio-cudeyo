RewriteEngine On

# Redirect .php URLs to clean URLs (preserving query string)
# Excluye stripe_webhook.php: Stripe no reenvía el body del POST tras un 301
RewriteCond %{THE_REQUEST} !\s/stripe_webhook\.php[\s?]
RewriteCond %{THE_REQUEST} \s/(.+?)\.php[\s?]
RewriteRule ^ /%1 [R=301,L,QSA]

# Internally map clean URLs to .php files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
